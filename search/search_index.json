7edf\", 334, 2),\n    (\"12.4 \u5929\u7ebf\u9009\u62e9\u6280\u672f\", 337, 2),\n    (\"12.4.1 \u6700\u4f18\u5929\u7ebf\u9009\u62e9\u6280\u672f\", 337, 3),\n    (\"12.4.2 \u590d\u6742\u5ea6\u964d\u4f4e\u7684\u5929\u7ebf\u9009\u62e9\u6280\u672f\", 339, 3),\n    (\"12.4.3 OSTBC\u7684\u5929\u7ebf\u9009\u62e9\", 342, 3),\n\n    # ========== \u7b2c13\u7ae0 ==========\n    (\"\u7b2c13\u7ae0 \u591a\u7528\u6237MIMO\", 346, 1),\n    (\"13.1 \u591a\u7528\u6237MIMO\u7cfb\u7edf\u7684\u6570\u5b66\u6a21\u578b\", 347, 2),\n    (\"13.2 \u591a\u7528\u6237MIMO\u7cfb\u7edf\u7684\u4fe1\u9053\u5bb9\u91cf\", 348, 2),\n    (\"13.2.1 MAC\u5bb9\u91cf\", 348, 3),\n    (\"13.2.2 BC\u5bb9\u91cf\", 349, 3),\n    (\"13.3 \u5e7f\u64ad\u4fe1\u9053\u7684\u4f20\u8f93\u65b9\u5f0f\", 350, 2),\n    (\"13.3.1 \u4fe1\u9053\u53cd\u8f6c\", 350, 3),\n    (\"13.3.2 \u5757\u5bf9\u89d2\u5316\", 353, 3),\n    (\"13.3.3 \u810f\u7eb8\u7f16\u7801\", 357, 3),\n    (\"13.3.4 Tomlinson-Harashima\u9884\u7f16\u7801\", 360, 3),\n\n    # ========== \u672b\u5c3e\u90e8\u5206\uff08\u65e0\u5b50\u8282\u70b9\uff0c\u4e00\u7ea7\u672b\u7ea7\uff09 ==========\n    (\"\u53c2\u8003\u6587\u732e\", 365, 1),\n    (\"\u7d22\u5f15\", 378, 1),\n]\n\n\ndef add_pdf_bookmark():\n    # \u521b\u5efaPDF\u5199\u5165\u5bf9\u8c61\uff0c\u6e05\u7a7a\u539f\u6709\u4e66\u7b7e\n    writer = PdfWriter()\n    with open(INPUT_PDF, \"rb\") as src_file:\n        writer.append(src_file, import_outline=False)\n\n    # \u8bb0\u5f55\u5404\u7ea7\u7236\u4e66\u7b7e\u8282\u70b9\n    parent_chapter = None   # \u4e00\u7ea7\u7236\u8282\u70b9\uff08\u7ae0\uff09\n    parent_section = None   # \u4e8c\u7ea7\u7236\u8282\u70b9\uff08\u8282\uff09\n\n    for title, book_page, level in catalog:\n        # \u8f6c\u6362\u4e3apypdf\u6240\u9700\u76840\u8d77\u59cb\u9875\u9762\u7d22\u5f15\n        pdf_page_index = book_page + OFFSET - 1\n\n        if level == 1:\n            # \u4e00\u7ea7\u7ae0\uff1a\u7236\u7ea7\u8282\u70b9\uff0c\u8bbe\u7f6e\u9ed8\u8ba4\u6298\u53e0 open=False\n            item = writer.add_outline_item(\n                title, pdf_page_index, parent=None, is_open=True\n            )\n            parent_chapter = item\n            parent_section = None  # \u5207\u6362\u7ae0\u8282\u65f6\u91cd\u7f6e\u4e8c\u7ea7\u7236\u8282\u70b9\n\n        elif level == 2:\n            # \u4e8c\u7ea7\u8282\uff1a\u7236\u7ea7\u8282\u70b9\uff0c\u8bbe\u7f6e\u9ed8\u8ba4\u6298\u53e0 open=False\n            item = writer.add_outline_item(\n                title, pdf_page_index, parent=parent_chapter, is_open=True\n            )\n            parent_section = item\n\n        elif level == 3:\n            # \u4e09\u7ea7\u5c0f\u8282\uff1a\u672b\u7ea7\u8282\u70b9\uff0c\u65e0\u5b50\u4e66\u7b7e\uff0c\u65e0\u9700\u8bbe\u7f6eopen\n            writer.add_outline_item(\n                title, pdf_page_index, parent=parent_section, is_open=False\n            )\n\n    # \u8f93\u51fa\u6700\u7ec8PDF\u6587\u4ef6\n    with open(OUTPUT_PDF, \"wb\") as out_file:\n        writer.write(out_file)\n\n    print(f\"\u2705 \u5168\u90e8\u7236\u7ea7\u4e66\u7b7e\u9ed8\u8ba4\u6298\u53e0\u8bbe\u7f6e\u5b8c\u6210\uff01\")\n    print(f\"\ud83d\udcc4 \u8f93\u51fa\u6587\u4ef6\uff1a{OUTPUT_PDF}\")\n\n\nif __name__ == \"__main__\":\n    add_pdf_bookmark()\n\n\u6839\u636e\u76ee\u5f55\u66f4\u65b0\u4ee3\u7801 \u5176\u4e2d\u7b2c\u4e00\u9875\u5bf9\u5e94pdf\u7b2c27\u9875\n</code></pre>"},{"location":"%E8%AE%A1%E7%AE%97%E6%9C%BA/%E5%9B%BE%E8%AE%BA/","title":"\u56fe\u8bba","text":""},{"location":"%E8%AE%A1%E7%AE%97%E6%9C%BA/%E5%9B%BE%E8%AE%BA/#_1","title":"\u56fe\u8bba","text":"<p>\u56fe\u8bba\u90e8\u5206\u7b80\u4ecb - OI Wiki</p> <p>Tutorial \u2014 NetworkX 3.7 documentation</p>"},{"location":"%E8%AE%A1%E7%AE%97%E6%9C%BA/%E5%9F%BA%E7%A1%80%E8%AF%AD%E6%B3%95/","title":"\u57fa\u7840\u8bed\u6cd5","text":""},{"location":"%E8%AE%A1%E7%AE%97%E6%9C%BA/%E5%9F%BA%E7%A1%80%E8%AF%AD%E6%B3%95/#_1","title":"\u57fa\u7840\u8bed\u6cd5","text":""},{"location":"%E8%AE%A1%E7%AE%97%E6%9C%BA/%E5%9F%BA%E7%A1%80%E8%AF%AD%E6%B3%95/#c","title":"C\u8bed\u8a00","text":"<p>\u6d59\u6c5f\u5927\u5b66\u7fc1\u607a\u6559\u4f60C\u8bed\u8a00\u7a0b\u5e8f\u8bbe\u8ba1\uff01C\u8bed\u8a00\u57fa\u7840\u5165\u95e8\uff01_\u54d4\u54e9\u54d4\u54e9_bilibili</p> <p>\u9ed1\u9a6c\u7a0b\u5e8f\u5458\u5320\u5fc3\u4e4b\u4f5c|C++\u6559\u7a0b\u4ece0\u52301\u5165\u95e8\u7f16\u7a0b,\u5b66\u4e60\u7f16\u7a0b\u4e0d\u518d\u96be</p>"},{"location":"%E8%AE%A1%E7%AE%97%E6%9C%BA/%E5%9F%BA%E7%A1%80%E8%AF%AD%E6%B3%95/#python","title":"Python","text":"<p>Python\u6559\u7a0b - \u5ed6\u96ea\u5cf0\u7684\u5b98\u65b9\u7f51\u7ad9</p>"},{"location":"%E8%AE%A1%E7%AE%97%E6%9C%BA/%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84/","title":"\u6570\u636e\u7ed3\u6784","text":""},{"location":"%E8%AE%A1%E7%AE%97%E6%9C%BA/%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84/#_1","title":"\u6570\u636e\u7ed3\u6784","text":""},{"location":"%E8%AE%A1%E7%AE%97%E6%9C%BA/%E6%95%B0%E6%8D%AE%E7%BB%93%E6%9E%84/#_2","title":"\u8bfe\u7a0b\u63a8\u8350","text":"<p>Introduction to data structures - YouTube</p> <p>Introduction to data structures - YouTube \u4e2d\u6587\u7248 </p> <p>\u3010\u300a\u6570\u636e\u7ed3\u6784\uff08C \u8bed\u8a00\u63cf\u8ff0\uff09\u300b\u4e5f\u8bb8\u662f\u5168\u7ad9\u6700\u826f\u5fc3\u6700\u901a\u4fd7\u6613\u61c2\u6700\u597d\u770b\u7684\u6570\u636e\u7ed3\u6784\u8bfe\u3011 </p>"},{"location":"%E8%AE%A1%E7%AE%97%E6%9C%BA/%E7%AE%97%E6%B3%95/","title":"\u7b97\u6cd5","text":""},{"location":"%E8%AE%A1%E7%AE%97%E6%9C%BA/%E7%AE%97%E6%B3%95/#_1","title":"\u7b97\u6cd5","text":""},{"location":"%E8%AE%A1%E7%AE%97%E6%9C%BA/%E7%AE%97%E6%B3%95/#-hello","title":"\u5e8f - Hello \u7b97\u6cd5","text":""},{"location":"%E8%BF%90%E5%8A%A8/","title":"\u8fd0\u52a8","text":""},{"location":"%E8%BF%90%E5%8A%A8/#_1","title":"\u8fd0\u52a8","text":""},{"location":"%E8%BF%90%E5%8A%A8/#_2","title":"\u5065\u8eab","text":""},{"location":"%E8%BF%90%E5%8A%A8/#_3","title":"\u8179\u808c","text":""},{"location":"%E8%BF%90%E5%8A%A8/#_4","title":"\u624b\u81c2","text":""},{"location":"%E8%BF%90%E5%8A%A8/#_5","title":"\u7fbd\u6bdb\u7403","text":""}]}